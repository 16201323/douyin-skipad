<resources>
    <!-- AppCompatActivity 必须使用 Theme.AppCompat 系列主题，否则崩溃 -->
    <style name="Theme.SkipAd" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/ui_accent</item>
        <item name="colorControlActivated">@color/ui_accent</item>
        <item name="android:windowBackground">@color/ui_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">@color/ui_background</item>
        <item name="android:statusBarColor">@color/ui_background</item>
        <item name="android:navigationBarColor">@color/ui_surface</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
</resources>
