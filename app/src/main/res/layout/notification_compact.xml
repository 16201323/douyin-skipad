<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="48dp"
    android:gravity="center_vertical" android:orientation="horizontal">
    <TextView android:id="@+id/notification_status" android:layout_width="0dp"
        android:layout_height="wrap_content" android:layout_weight="1"
        style="@style/TextAppearance.Compat.Notification" android:textSize="12sp" android:maxLines="2"
        android:layout_marginEnd="8dp" />
    <Button android:id="@+id/notification_auto" android:layout_width="wrap_content"
        android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp"
        android:background="@drawable/notification_primary" android:backgroundTint="@null"
        android:textColor="@color/ui_accent" android:textSize="12sp" android:textAllCaps="false"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:gravity="center" />
    <Button android:id="@+id/notification_floating" android:layout_width="wrap_content"
        android:layout_height="40dp" android:minWidth="0dp" android:minHeight="0dp"
        android:layout_marginStart="8dp" android:background="@drawable/notification_secondary"
        android:backgroundTint="@null" android:textColor="@color/ui_accent" android:textSize="12sp"
        android:textAllCaps="false" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:gravity="center" />
</LinearLayout>
